# Backend API — required for lead capture, contact form, and demo booking to persist to the database
# Set this to the root of your API (same backend that serves the hotel POS).
# The marketing site will POST to ${VITE_API_URL}/inquiries/contact and /inquiries/demo.
# Also add the marketing site's domain to ALLOWED_ORIGINS on the backend.
VITE_API_URL=https://your-backend-api-url/api

# EmailJS — no longer used for form delivery (backend handles email now).
# Kept here in case a fallback is needed; remove if not needed.
VITE_EMAILJS_SERVICE_ID=service_xxxxxxx
VITE_EMAILJS_CONTACT_TEMPLATE_ID=template_xxxxxxx
VITE_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxxxxxx
