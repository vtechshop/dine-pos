# EmailJS — required for the contact form to deliver email directly to info@happya.in
# Sign up at https://www.emailjs.com, then:
#   1. Add an email service (Gmail / SMTP) → copy the Service ID
#   2. Create a contact template with variables: from_name, from_email, from_phone, restaurant, message
#      Set "To Email" in the template to info@happya.in
#   3. Copy the Template ID and your account's Public Key (Account → API Keys)
VITE_EMAILJS_SERVICE_ID=service_xxxxxxx
VITE_EMAILJS_CONTACT_TEMPLATE_ID=template_xxxxxxx
VITE_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxxxxxx
