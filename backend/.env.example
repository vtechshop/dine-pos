# ──────────────────────────────────────────────────────────────────────────────
# Dine POS — Backend Environment Variables
# Copy this file to .env and fill in every value before starting the server.
# Variables marked REQUIRED will cause the server to exit(1) if missing.
# ──────────────────────────────────────────────────────────────────────────────

# ── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=development                      # production | staging | development
PORT=5000

# ── Database (REQUIRED) ───────────────────────────────────────────────────────
# MongoDB Atlas: Settings → Database → Connect → Drivers → copy connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/dinepos?retryWrites=true&w=majority

# ── Authentication (REQUIRED) ─────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_BYTE_HEX_SECRET

# Separate secret for super-admin JWTs. Falls back to JWT_SECRET if unset,
# but a distinct value is strongly recommended so hotel and super-admin tokens
# cannot be cross-used even if one secret leaks.
SUPER_ADMIN_JWT_SECRET=REPLACE_WITH_DIFFERENT_64_BYTE_HEX_SECRET

# ── Super Admin (REQUIRED) ────────────────────────────────────────────────────
SUPER_ADMIN_ID=your_superadmin_username
SUPER_ADMIN_PASS=your_superadmin_password

# ── CORS (REQUIRED in production) ────────────────────────────────────────────
# Comma-separated list of all frontend origins that may call the API.
# Example for production:
ALLOWED_ORIGINS=https://app.dinepos.com,https://qr.dinepos.com,https://admin.dinepos.com,https://www.dinepos.com
# For local dev (leave blank to allow all):
# ALLOWED_ORIGINS=

# WebSocket CSP origin (REQUIRED in production) ── restricts connectSrc to this host.
# Without it the CSP falls back to wss:/ws: (any domain). Set to the API host.
SOCKET_ORIGIN=wss://api.dinepos.com
# Leave unset in local dev.

# ── Redis (REQUIRED when running >1 backend instance) ────────────────────────
# Upstash Redis: create a database → copy REST URL (ioredis format).
# Without this, Socket.IO uses in-memory adapter — safe for 1 instance only.
# Omit entirely for local development (app runs without Redis).
REDIS_URL=rediss://:<password>@<host>.upstash.io:6379

# ── Image Uploads (REQUIRED for product image uploads) ───────────────────────
# Cloudinary: Dashboard → API Keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Aggregator Webhook (REQUIRED if aggregator feature is enabled) ────────────
# Shared secret sent by Swiggy/Zomato webhook integrations in X-Aggregator-Secret header.
AGGREGATOR_SECRET=REPLACE_WITH_RANDOM_SECRET

# ── Lead Email Alerts (REQUIRED for lead notification emails to super admin) ──
# SMTP credentials used by emailService.ts to send new-lead alert emails.
# Recommended: create a transactional email account (SendGrid, Brevo, Postmark)
# and configure it to relay through their SMTP gateway.
# Example (Gmail SMTP — not recommended for production volume):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_USER=you@gmail.com
#   SMTP_PASS=<app-password>       # Google App Password, not your login password
# Example (SendGrid):
#   SMTP_HOST=smtp.sendgrid.net
#   SMTP_PORT=465
#   SMTP_USER=apikey
#   SMTP_PASS=SG.<your-api-key>
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=noreply@example.com
SMTP_PASS=REPLACE_WITH_SMTP_PASSWORD
# Email address that receives new-lead alert emails from the contact/demo forms.
LEAD_ALERT_EMAIL=sales@example.com

# ── QR App (optional — enables React QR SPA redirect) ───────────────────────
# When set, GET /menu and GET /menu/* redirect (301) to this URL, preserving
# query parameters. Leave unset to keep serving the legacy vanilla JS PWA.
# QR_APP_URL=https://qr.dinepos.com

# ── AI Menu Import (optional — enables the AI Menu Import feature) ───────────
# Google AI Studio: https://aistudio.google.com → Get API Key
GEMINI_API_KEY=your_gemini_api_key
# Override the default model (default: gemini-2.5-flash).
# Use 'gemini-2.5-flash-preview-05-20' if the stable alias is unavailable.
# GEMINI_MODEL=gemini-2.5-flash

# ── Error Tracking (optional but strongly recommended for production) ─────────
# Sentry: https://sentry.io → Projects → DSN
SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>

# ── Log Aggregation (optional but strongly recommended for production) ────────
# Better Stack (Logtail): https://logs.betterstack.com → Sources → Source Token
LOGTAIL_SOURCE_TOKEN=your_logtail_token

# ── Payment Encryption (REQUIRED when payment gateway feature is enabled) ──────
# 64-character hex string used to AES-256-GCM encrypt gateway credentials at rest.
# All payment keys, OAuth tokens, and webhook secrets are encrypted with this key.
# Generate with: openssl rand -hex 32
# REQUIRED in production; omitting it in dev means payment features will not work.
PAYMENT_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARS

# ── Razorpay Technology Partner OAuth (optional — enables OAuth gateway connect) ─
# Obtain from: Razorpay Partner Dashboard → Apps → your app → OAuth Credentials
#
# RAZORPAY_CLIENT_ID:             Your OAuth application's client identifier.
# RAZORPAY_CLIENT_SECRET:         Keep secret. NEVER expose to frontend or logs.
# RAZORPAY_OAUTH_REDIRECT_URI:    The backend callback URL — must exactly match
#                                 what is registered in the Razorpay Partner Dashboard.
#                                 Example: https://api.yourdomain.com/api/razorpay/oauth/callback
# RAZORPAY_PARTNER_WEBHOOK_SECRET: Secret for verifying partner-level webhook events
#                                 (e.g. account.app.authorization_revoked).
#                                 Configure in Razorpay Partner Dashboard → Webhooks.
#
# Note: Redis (REDIS_URL) is REQUIRED for the OAuth connect flow — state tokens are
# stored in Redis to prevent CSRF. The OAuth feature will return 503 if Redis is unavailable.
RAZORPAY_CLIENT_ID=your_razorpay_oauth_client_id
RAZORPAY_CLIENT_SECRET=REPLACE_WITH_RAZORPAY_CLIENT_SECRET
RAZORPAY_OAUTH_REDIRECT_URI=https://api.yourdomain.com/api/razorpay/oauth/callback
RAZORPAY_PARTNER_WEBHOOK_SECRET=REPLACE_WITH_PARTNER_WEBHOOK_SECRET

# ── DinePOS SaaS Billing (Razorpay Subscriptions) ─────────────────────────────
# SEPARATE Razorpay account used for collecting annual SaaS fees from hotels.
# Do NOT mix with the per-hotel OAuth keys above.
#
# Step 1: Create these keys in your DinePOS Razorpay dashboard (Settings → API Keys)
# Step 2: Run `node src/scripts/create-standard-razorpay-plan.js` once to create the
#          ₹12,000/year plan, then copy the returned plan_id below.
# Step 3: Create a webhook in Razorpay Dashboard → Webhooks → Add New Webhook
#          URL: https://api.yourdomain.com/api/saas/webhook
#          Events: subscription.activated, subscription.authenticated, subscription.halted,
#                  subscription.cancelled, subscription.completed, invoice.paid, invoice.payment_failed
#          Secret: paste the same value as RAZORPAY_SAAS_WEBHOOK_SECRET below
RAZORPAY_SAAS_KEY_ID=rzp_live_REPLACE_ME
RAZORPAY_SAAS_KEY_SECRET=REPLACE_WITH_SAAS_KEY_SECRET
RAZORPAY_PLAN_ID_STANDARD=plan_REPLACE_AFTER_RUNNING_SCRIPT
RAZORPAY_SAAS_WEBHOOK_SECRET=REPLACE_WITH_SAAS_WEBHOOK_SECRET
