# Dependencies
node_modules/

# Environment files (NEVER commit these)
.env
.env.local
.env.production
backend/.env
automation/.env.test
# Exception: apps/web/.env.production contains only public domain URLs (no secrets).
# Vite bakes VITE_API_URL/VITE_SOCKET_URL into the JS bundle at build time;
# without this file committed, production builds fall back to localhost URLs.
!web/.env.production
!qr/.env.production

# Automation runtime artifacts (generated per-run, contain tokens/secrets)
automation/.test-state.json
automation/web/.web-test-state.json
automation/reports/

# Build outputs
dist/
build/

# Logs
*.log
npm-debug.*
yarn-debug.*
yarn-error.*

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/settings.json
*.pem

# Expo
.expo/
web-build/

# Google Play key (sensitive)
mobile/google-play-key.json

# Android signing credentials — never commit these
mobile/android/keystore.properties
mobile/android/*.keystore
mobile/android/app/*.keystore

# Claude Code internal files (worktrees contain node_modules, local session state)
.claude/

# CI log archives (generated, binary)
ci_logs.zip
ci_logs_extracted/
ci_logs_out/
